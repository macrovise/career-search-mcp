# Default is fail-closed OAuth. Use local only on loopback, never through a public tunnel.
CAREER_AUTH_MODE=oauth
CAREER_PUBLIC_URL=https://career.example.com
OAUTH_ISSUER=https://identity.example.com/
OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OAUTH_OWNER_SUBJECT=replace-with-your-provider-subject-id
MCP_HOST=127.0.0.1
MCP_PORT=8383
CAREER_DB_PATH=data/career.sqlite3
CAREER_SOURCES=himalayas,remotive,jobicy,weworkremotely
WATCH_INTERVAL_SECONDS=21600
# Optional official Adzuna GB API; add adzuna to CAREER_SOURCES after setting both.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional Scout; requires provider-issued token for this client, never a copied ChatGPT token.
SCOUT_ACCESS_TOKEN=
# Leave blank until the actual scout_discover input schema is verified.
SCOUT_DISCOVER_ARGUMENTS=
