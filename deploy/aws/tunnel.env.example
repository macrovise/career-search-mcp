# Supply the existing approved tunnel ID before starting career-tunnel.service.
# The runtime key is a separate root-only file, never an environment value here.
CONTROL_PLANE_TUNNEL_ID=
MCP_SERVER_URL=http://127.0.0.1:8383/mcp
MCP_STARTUP_WAIT_TIMEOUT=60s
HEALTH_LISTEN_ADDR=127.0.0.1:8384
XDG_CONFIG_HOME=/var/lib/career-tunnel/config
XDG_STATE_HOME=/var/lib/career-tunnel/state
XDG_CACHE_HOME=/var/lib/career-tunnel/cache
